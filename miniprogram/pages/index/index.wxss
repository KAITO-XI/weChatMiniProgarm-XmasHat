.container {
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  margin-bottom: 30px;
  text-align: center;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #d32f2f; /* Christmas Red */
  display: block;
  margin-bottom: 10px;
}

.subtitle {
  font-size: 14px;
  color: #666;
}

.upload-section {
  width: 100%;
  height: 300px;
  background-color: #fff;
  border-radius: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20px;
  border: 2px dashed #ddd;
  overflow: hidden;
}

.image-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.plus-icon {
  font-size: 40px;
  margin-bottom: 10px;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.input-section {
  width: 100%;
  margin-bottom: 20px;
}

.prompt-input {
  width: 100%;
  height: 40px;
  background-color: #fff;
  border-radius: 5px;
  padding: 0 10px;
  box-sizing: border-box;
  border: 1px solid #eee;
}

.action-section {
  width: 100%;
  margin-bottom: 30px;
}

.btn-generate {
  background-color: #d32f2f;
  color: #fff;
  border-radius: 25px;
  width: 100%;
}

.result-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-top: 1px solid #eee;
  padding-top: 20px;
}

.result-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 15px;
}

.result-image {
  width: 100%;
  height: 300px;
  border-radius: 10px;
  margin-bottom: 20px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.result-actions {
  display: flex;
  gap: 10px;
  width: 100%;
  justify-content: center;
}

.btn-secondary {
  background-color: #fff;
  color: #333;
  border: 1px solid #ddd;
  font-size: 14px;
}
